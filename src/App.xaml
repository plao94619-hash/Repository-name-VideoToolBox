<Application
    x:Class="WinCare.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <AcrylicBrush x:Key="CardBrush" TintColor="#FFF8F9FF" TintOpacity="0.82" FallbackColor="#FFF6F7FC" />
                    <AcrylicBrush x:Key="NavBrush" TintColor="#FFE9ECF7" TintOpacity="0.72" FallbackColor="#FFEEF0F8" />
                    <SolidColorBrush x:Key="RowBrush" Color="#DDFBFCFF" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#FF20212A" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF686B79" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#88FFFFFF" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#FF5149C8" />
                    <SolidColorBrush x:Key="AccentOnBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#265149C8" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#FF187A62" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#221F9D77" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#FF9A5B0A" />
                    <SolidColorBrush x:Key="WarningSoftBrush" Color="#22D88A17" />
                    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#1A777B8B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="CardBrush" TintColor="#FFF8F9FF" TintOpacity="0.82" FallbackColor="#FFF6F7FC" />
                    <AcrylicBrush x:Key="NavBrush" TintColor="#FFE9ECF7" TintOpacity="0.72" FallbackColor="#FFEEF0F8" />
                    <SolidColorBrush x:Key="RowBrush" Color="#DDFBFCFF" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#FF20212A" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF686B79" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#88FFFFFF" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#FF5149C8" />
                    <SolidColorBrush x:Key="AccentOnBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#265149C8" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#FF187A62" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#221F9D77" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#FF9A5B0A" />
                    <SolidColorBrush x:Key="WarningSoftBrush" Color="#22D88A17" />
                    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#1A777B8B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush x:Key="CardBrush" TintColor="#FF20222D" TintOpacity="0.82" FallbackColor="#FF242631" />
                    <AcrylicBrush x:Key="NavBrush" TintColor="#FF171923" TintOpacity="0.76" FallbackColor="#FF191B25" />
                    <SolidColorBrush x:Key="RowBrush" Color="#D9252733" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#FFF4F4F8" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#FFB5B7C2" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#FFB3AEFF" />
                    <SolidColorBrush x:Key="AccentOnBrush" Color="#FF171923" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#385F58E8" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#FF72D2B0" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2A28A77F" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#FFFFC66C" />
                    <SolidColorBrush x:Key="WarningSoftBrush" Color="#32D88A17" />
                    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#25FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NavBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="RowBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentOnBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="WarningSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NeutralSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
