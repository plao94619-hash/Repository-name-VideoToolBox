#!name=墨鱼去广告
#!desc=Shadowrocket转换合集：URL拦截、JSON正文重写、域名/IP拒绝及微信读书
#!author=规则源作者见模块注释与项目README
#!homepage=https://github.com/plao94619-hash/Repository-name-VideoToolBox/tree/main/extras/shadowrocket/moyu-adblock
#!category=AdBlock

# 墨鱼去广告 Shadowrocket 转换版
# 已转换 URL reject、JSON jq、简单正文替换及域名/IP reject 规则。
# 保留一条上游 WeRead HTTP 响应脚本；其他依赖客户端专用脚本 API 的规则不在本版范围。

[Rule]
# Converted reject-only host/IP rules. Direct-routing entries are excluded.
