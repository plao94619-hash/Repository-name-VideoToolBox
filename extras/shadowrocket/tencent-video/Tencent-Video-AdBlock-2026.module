#!name=腾讯视频广告拦截（开屏/首页弹窗/个人中心）
#!desc=版本1.3.3：新增个人中心广告点击落地域名jump01.gw62.cn精确拦截；此规则阻止打开该广告落地页，不保证隐藏已显示的广告卡片。保留腾讯广告和开屏候选规则。HTTPS路径过滤需启用并信任自己设备生成的Shadowrocket CA。
#!author=plao94619-hash
#!homepage=https://github.com/plao94619-hash/Repository-name-VideoToolBox/tree/main/extras/shadowrocket/tencent-video
#!system=ios
#!category=AdBlock
#!arguments=启用精准HTTPS过滤:true,腾讯广告接口策略:REJECT,腾讯广告素材策略:REJECT,开屏广告策略:REJECT,首页弹窗广告策略:REJECT,腾讯GDT广告策略:REJECT,IACC推荐接口策略:REJECT
#!arguments-desc=启用精准HTTPS过滤：用于匹配指定HTTPS广告路径。需在当前Shadowrocket配置中开启HTTPS解密，并在iOS中信任你自己生成的CA；如腾讯视频出现网络异常，可将此参数设为false。设为false后，精确域名规则仍有效。\n\n腾讯广告接口策略：仅匹配iacc.qq.com。腾讯广告素材策略：仅匹配pgdt.gtimg.cn。开屏广告策略：匹配splashqqlive.gtimg.com。首页弹窗广告策略：匹配adsmind.gdtimg.com。腾讯GDT广告策略：仅匹配c3.gdt.qq.com、v3.gdt.qq.com、xs.gdt.qq.com、mi.gdt.qq.com；IACC推荐接口策略：仅匹配iacc.rec.qq.com。c2.l.qq.com、p2.l.qq.com、livep2.l.qq.com三个个人中心候选主机固定为REJECT，不使用可设为代理的策略参数。

# Version 1.3.3, 2026-10-03. Adds the exact personal-center ad click-through host jump01.gw62.cn, based on the user-provided destination URL and the latest route log.

[Rule]
# 2026-10-03 10:40流量记录中命中；精确主机匹配。
DOMAIN,iacc.qq.com,{{{腾讯广告接口策略}}}
DOMAIN,pgdt.gtimg.cn,{{{腾讯广告素材策略}}}
# Splash asset host from community Tencent Video filters; exact host only.
DOMAIN,splashqqlive.gtimg.com,{{{开屏广告策略}}}
# Tencent ad creative host from community Tencent Video filters; exact host only.
DOMAIN,adsmind.gdtimg.com,{{{首页弹窗广告策略}}}
# Traffic from the profile-ad display window routed these ad network endpoints DIRECT.
DOMAIN,c3.gdt.qq.com,{{{腾讯GDT广告策略}}}
DOMAIN,v3.gdt.qq.com,{{{腾讯GDT广告策略}}}
DOMAIN,xs.gdt.qq.com,{{{腾讯GDT广告策略}}}
# Official Tencent GDT ad-request host; exact hostname only.
DOMAIN,mi.gdt.qq.com,{{{腾讯GDT广告策略}}}
DOMAIN,iacc.rec.qq.com,{{{IACC推荐接口策略}}}
# Exact hosts from the profile-ad display window; keep scope narrow.
DOMAIN,c2.l.qq.com,REJECT
DOMAIN,p2.l.qq.com,REJECT
DOMAIN,livep2.l.qq.com,REJECT
# User-provided profile-card click destination; exact host only. Blocks navigation, not the card's rendering.
DOMAIN,jump01.gw62.cn,REJECT

[URL Rewrite]
# 开屏图素材：只匹配网站编号路径。
^https?:\/\/splashqqlive\.gtimg\.com\/website\/\d{6} - reject
# 首页弹窗广告数据与创意图路径。
^https?:\/\/news\.l\.qq\.com\/app\?(?:[^#]*)$ - reject-dict
^https?:\/\/wa\.gtimg\.com\/adxcdn\/[^?#]+\.jpg(?:\?[^#]*)?$ - reject-img
# 个人中心视频卡片：只匹配被社区规则识别为广告素材的MP4路径。
^https?:\/\/video\.dispatch\.tc\.qq\.com\/[^?#]+\.mp4(?:\?[^#]*)?$ - reject
^https?:\/\/[^?#]*vmind\.qqvideo\.tc\.qq\.com\/[^?#]+\.mp4(?:\?[^#]*)?$ - reject

[MITM]
enable={{{启用精准HTTPS过滤}}}
h2=true
hostname = %APPEND% splashqqlive.gtimg.com, news.l.qq.com, wa.gtimg.com, video.dispatch.tc.qq.com, vmind.qqvideo.tc.qq.com
