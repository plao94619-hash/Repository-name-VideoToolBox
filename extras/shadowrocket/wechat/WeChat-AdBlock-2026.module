#!name=微信广告拦截（2026.10.02）
#!desc=过滤公众号广告及部分小程序 SDK、企迈、美团点餐广告。朋友圈 MMTLS 信息流不支持；不保证全部小程序广告。需要安装并信任自己的 CA。
#!author=plao94619-hash
#!homepage=https://github.com/plao94619-hash/Repository-name-VideoToolBox/tree/main/extras/shadowrocket/wechat
#!system=ios
#!category=AdBlock
#!arguments=启用HTTPS解密:true
#!arguments-desc=启用HTTPS解密：先安装并完全信任你自己设备上由 Shadowrocket 生成的 CA。HTTPS 解密关闭时，URL 重写与响应脚本无法处理 HTTPS 广告。

[Rule]
# 已知微信小程序广告视频资源；不封锁微信核心或整个 wxs.qq.com。
DOMAIN-SUFFIX,wxsmsdy.video.qq.com,REJECT

[URL Rewrite]
# 公众号专用广告接口；getappmsgad 由下方脚本保留响应结构。
^https?:\/\/mp\.weixin\.qq\.com\/mp\/advertisement(?:[/?]|$) - reject-dict
^https?:\/\/mp\.weixin\.qq\.com\/mp\/ad_[^/?]+(?:[/?]|$) - reject-dict
# 微信通用小程序广告请求/曝光，兼容 action 位于不同查询参数位置。
^https?:\/\/mp\.weixin\.qq\.com\/wapad\/getaddata\?(?:[^#]*&)?action=getad(?:&|$) - reject-200
^https?:\/\/mp\.weixin\.qq\.com\/wapad\/reportaddata\?(?:[^#]*&)?action=exposure_report(?:&|$) - reject-200
# 企迈系小程序的专用画布广告接口。
^https?:\/\/(?:webapi|miniapp)\.qmai\.cn\/web\/cmk-center\/marketing\/canvas\/advert(?:[/?]|$) - reject-dict

[Script]
# 脚本固定到本仓库经过验证的提交；更新模块时才切换脚本版本。
WeChat-公众号广告 = type=http-response,pattern=^https?:\/\/mp\.weixin\.qq\.com\/mp\/getappmsgad(?:\?|$),requires-body=1,max-size=1048576,script-path=https://raw.githubusercontent.com/plao94619-hash/Repository-name-VideoToolBox/08cb2a7438a8c2c4eb475dc752668b3944c03b19/extras/shadowrocket/wechat/wechat-ad-filter.js,script-update-interval=0,engine=jsc
WeChat-企迈小程序广告 = type=http-response,pattern=^https?:\/\/(?:webapi|miniapp)\.qmai\.cn\/web\/catering(?:[0-9]-apiserver)?\/advertising\/ad\/advertiseInfo(?:\?|$),requires-body=1,max-size=1048576,script-path=https://raw.githubusercontent.com/plao94619-hash/Repository-name-VideoToolBox/08cb2a7438a8c2c4eb475dc752668b3944c03b19/extras/shadowrocket/wechat/wechat-ad-filter.js,script-update-interval=0,engine=jsc
WeChat-美团点餐广告 = type=http-response,pattern=^https?:\/\/rms\.meituan\.com\/api\/v\d+\/rmsmina\/c\/queryPortalInfo(?:\?|$),requires-body=1,max-size=1048576,script-path=https://raw.githubusercontent.com/plao94619-hash/Repository-name-VideoToolBox/08cb2a7438a8c2c4eb475dc752668b3944c03b19/extras/shadowrocket/wechat/wechat-ad-filter.js,script-update-interval=0,engine=jsc

[MITM]
enable={{{启用HTTPS解密}}}
h2=true
hostname = %APPEND% mp.weixin.qq.com, webapi.qmai.cn, miniapp.qmai.cn, rms.meituan.com
